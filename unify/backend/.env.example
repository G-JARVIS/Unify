PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# ── Firebase ───────────────────────────────────────────────────────────────────
# No service account needed — the backend talks to Firebase over its public
# REST APIs, authenticated as each caller (see src/lib/firestoreRest.js).
# Same values as frontend/.env's VITE_FIREBASE_PROJECT_ID / VITE_FIREBASE_API_KEY
# (Firebase Console → gear icon → Project Settings → General → Your apps → Web app).
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# ── App config ─────────────────────────────────────────────────────────────────
# Comma-separated list of emails that get admin access on signup.
ADMIN_EMAILS=admin@unify.com
# Only used by `npm run seed` to create the first admin account.
ADMIN_SEED_PASSWORD=
